{
  "@@locale": "en",
  "permissionsDeniedBody": "SSID and BSSID stay redacted until you allow Location Services for this app. RF metrics may still update.",
  "@permissionsDeniedBody": {
    "description": "TS MessageKey: permissions.denied.body"
  },
  "permissionsDeniedTitle": "Network names are hidden",
  "@permissionsDeniedTitle": {
    "description": "TS MessageKey: permissions.denied.title"
  },
  "permissionsLocationBody": "On macOS, Wi‑Fi network names (SSID) and hardware addresses (BSSID) are treated as location-related data. LV24 WiFi Explorer requests Location Services only to unlock those fields — not to track GPS position or show maps.",
  "@permissionsLocationBody": {
    "description": "TS MessageKey: permissions.location.body"
  },
  "permissionsLocationSettingsHint": "Turn on Location Services globally, then enable LV24 WiFi Explorer in System Settings → Privacy & Security → Location Services.",
  "@permissionsLocationSettingsHint": {
    "description": "TS MessageKey: permissions.location.settingsHint"
  },
  "permissionsLocationTitle": "Location Services",
  "@permissionsLocationTitle": {
    "description": "TS MessageKey: permissions.location.title"
  },
  "permissionsOnboardingBody": "Active scanning can show signal and channels without Location. To list network names and MAC addresses, allow Location when prompted.",
  "@permissionsOnboardingBody": {
    "description": "TS MessageKey: permissions.onboarding.body"
  },
  "permissionsOnboardingTitle": "Wi‑Fi identity on macOS",
  "@permissionsOnboardingTitle": {
    "description": "TS MessageKey: permissions.onboarding.title"
  },
  "permissionsOpenSettings": "Open Location Settings",
  "@permissionsOpenSettings": {
    "description": "TS MessageKey: permissions.openSettings"
  },
  "permissionsRestrictedBody": "A device policy blocks Location Services. You can still view RF-only scan data or use demo mode where available.",
  "@permissionsRestrictedBody": {
    "description": "TS MessageKey: permissions.restricted.body"
  },
  "permissionsRestrictedTitle": "Location restricted",
  "@permissionsRestrictedTitle": {
    "description": "TS MessageKey: permissions.restricted.title"
  },
  "onboardingLocationContinue": "Continue",
  "@onboardingLocationContinue": {
    "description": "TS MessageKey: onboarding.location.continue"
  },
  "onboardingLocationLater": "Not now",
  "@onboardingLocationLater": {
    "description": "TS MessageKey: onboarding.location.later"
  },
  "onboardingLocationRetry": "Retry",
  "@onboardingLocationRetry": {
    "description": "TS MessageKey: onboarding.location.retry"
  },
  "permissionsPlatformAndroidBody": "Android treats Wi‑Fi scan results as location-related. WifiManager needs Location (and Nearby Wi‑Fi devices on Android 13+). The OS throttles startScan; this is not macOS ScanCore richness.",
  "@permissionsPlatformAndroidBody": {
    "description": "TS MessageKey: permissions.platform.android.body"
  },
  "permissionsPlatformAndroidSettingsHint": "Enable Location, grant this app, and keep Wi‑Fi on. Empty or stale rows usually mean the OS is throttling scans.",
  "@permissionsPlatformAndroidSettingsHint": {
    "description": "TS MessageKey: permissions.platform.android.settingsHint"
  },
  "permissionsPlatformAndroidTitle": "Android location unlocks WifiManager results",
  "@permissionsPlatformAndroidTitle": {
    "description": "TS MessageKey: permissions.platform.android.title"
  },
  "permissionsPlatformIosBody": "Apple does not give third-party apps a CoreWLAN-style full scan. This client can show the connected network when Location When In Use allows Wi‑Fi identity — not a roaming site survey.",
  "@permissionsPlatformIosBody": {
    "description": "TS MessageKey: permissions.platform.ios.body"
  },
  "permissionsPlatformIosSettingsHint": "Settings → Privacy & Security → Location Services → While Using. SSID and BSSID stay redacted without that grant.",
  "@permissionsPlatformIosSettingsHint": {
    "description": "TS MessageKey: permissions.platform.ios.settingsHint"
  },
  "permissionsPlatformIosTitle": "iOS cannot scan every nearby network",
  "@permissionsPlatformIosTitle": {
    "description": "TS MessageKey: permissions.platform.ios.title"
  },
  "permissionsPlatformLinuxBody": "Live Linux rows come from NetworkManager GetAccessPoints over the public D-Bus API — not iw, not monitor mode. Some desktops also hide SSID until a location or geoclue prompt is allowed.",
  "@permissionsPlatformLinuxBody": {
    "description": "TS MessageKey: permissions.platform.linux.body"
  },
  "permissionsPlatformLinuxSettingsHint": "Allow location or geoclue if the portal asks. Otherwise you may only see the connected network, or demo fixtures.",
  "@permissionsPlatformLinuxSettingsHint": {
    "description": "TS MessageKey: permissions.platform.linux.settingsHint"
  },
  "permissionsPlatformLinuxTitle": "Linux NetworkManager public D-Bus",
  "@permissionsPlatformLinuxTitle": {
    "description": "TS MessageKey: permissions.platform.linux.title"
  },
  "permissionsPlatformMacosBody": "On macOS, SSID and BSSID are CoreLocation-gated. LV24 asks for Location When In Use only to unlock those fields through a live ScanCore helper — not GPS or maps.",
  "@permissionsPlatformMacosBody": {
    "description": "TS MessageKey: permissions.platform.macos.body"
  },
  "permissionsPlatformMacosSettingsHint": "Turn on Location Services, enable LV24 WiFi Explorer (and ScanCore if you run it standalone), then use a signed live ScanCore. Ad-hoc or unsigned helpers fall back to demo fixtures.",
  "@permissionsPlatformMacosSettingsHint": {
    "description": "TS MessageKey: permissions.platform.macos.settingsHint"
  },
  "permissionsPlatformMacosTitle": "Wi‑Fi identity on macOS",
  "@permissionsPlatformMacosTitle": {
    "description": "TS MessageKey: permissions.platform.macos.title"
  },
  "permissionsPlatformOtherBody": "This build cannot promise a macOS-class active scan. SSID and BSSID may need OS location permission; otherwise you see RF-only fields, an associated link, or demo fixtures.",
  "@permissionsPlatformOtherBody": {
    "description": "TS MessageKey: permissions.platform.other.body"
  },
  "permissionsPlatformOtherSettingsHint": "Open system location settings if the OS asks. Windows v1 is associated-link plus demo fixtures, not a nearby-BSS survey.",
  "@permissionsPlatformOtherSettingsHint": {
    "description": "TS MessageKey: permissions.platform.other.settingsHint"
  },
  "permissionsPlatformOtherTitle": "Location and scan limits",
  "@permissionsPlatformOtherTitle": {
    "description": "TS MessageKey: permissions.platform.other.title"
  },
  "permissionsPlatformWindowsBody": "Windows v1 uses Native Wifi WlanQueryInterface for the connected network. There is no public nearby-BSS survey. Location may unlock Wi‑Fi identity; it does not turn this into a site survey.",
  "@permissionsPlatformWindowsBody": {
    "description": "TS MessageKey: permissions.platform.windows.body"
  },
  "permissionsPlatformWindowsSettingsHint": "If Windows asks for location to show the current SSID or BSSID, allow it. Without an association you see demo fixtures.",
  "@permissionsPlatformWindowsSettingsHint": {
    "description": "TS MessageKey: permissions.platform.windows.settingsHint"
  },
  "permissionsPlatformWindowsTitle": "Windows associated link only",
  "@permissionsPlatformWindowsTitle": {
    "description": "TS MessageKey: permissions.platform.windows.title"
  },
  "scanDegradedAndroidThrottledBody": "WifiManager limited this scan (OS throttle or SCAN_FAILED). Results may be stale; the next attempt backs off (30s or more).",
  "@scanDegradedAndroidThrottledBody": {
    "description": "TS MessageKey: scan.degraded.androidThrottled.body"
  },
  "scanDegradedAndroidThrottledTitle": "Android scan throttled",
  "@scanDegradedAndroidThrottledTitle": {
    "description": "TS MessageKey: scan.degraded.androidThrottled.title"
  },
  "scanDegradedDemoBody": "Live scan is not running. macOS needs Location When In Use plus a signed live ScanCore. iOS cannot full-scan; Android WifiManager is throttled; Linux uses public NetworkManager D-Bus; Windows is associated-link only.",
  "@scanDegradedDemoBody": {
    "description": "TS MessageKey: scan.degraded.demo.body"
  },
  "scanDegradedDemoTitle": "Demo data",
  "@scanDegradedDemoTitle": {
    "description": "TS MessageKey: scan.degraded.demo.title"
  },
  "scanDegradedIosConnectedOnlyBody": "There is no public iOS API for a full nearby BSS scan. Showing the associated network when identity is available.",
  "@scanDegradedIosConnectedOnlyBody": {
    "description": "TS MessageKey: scan.degraded.iosConnectedOnly.body"
  },
  "scanDegradedIosConnectedOnlyTitle": "iOS connected network only",
  "@scanDegradedIosConnectedOnlyTitle": {
    "description": "TS MessageKey: scan.degraded.iosConnectedOnly.title"
  },
  "scanDegradedLinuxNmBody": "Only public NetworkManager D-Bus data is available — often the connected network. This is not a full RF survey.",
  "@scanDegradedLinuxNmBody": {
    "description": "TS MessageKey: scan.degraded.linuxNm.body"
  },
  "scanDegradedLinuxNmTitle": "Linux NetworkManager limited",
  "@scanDegradedLinuxNmTitle": {
    "description": "TS MessageKey: scan.degraded.linuxNm.title"
  },
  "scanDegradedWindowsConnectedOnlyBody": "Native Wifi reports the connected network (SSID, BSSID, quality). Nearby BSS rows, channel, and IEs are not available in this v1 path.",
  "@scanDegradedWindowsConnectedOnlyBody": {
    "description": "TS MessageKey: scan.degraded.windowsConnectedOnly.body"
  },
  "scanDegradedWindowsConnectedOnlyTitle": "Windows associated link only",
  "@scanDegradedWindowsConnectedOnlyTitle": {
