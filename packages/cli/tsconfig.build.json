{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@lv24/wifi-core": ["../core/dist/index.d.ts"],
      "@lv24/wifi-core/scan": ["../core/dist/scan/index.d.ts"],
      "@lv24/wifi-backend": ["../backend/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
