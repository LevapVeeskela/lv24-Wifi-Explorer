{
  "name": "@lv24/wifi-core",
  "version": "1.0.1",
  "description": "Platform-agnostic Wi-Fi scan domain: BSS/ESS models, IE decode, signal, filters, merge, issues, channel math.",
  "homepage": "https://github.com/LevapVeeskela/lv24-Wifi-Explorer#readme",
  "bugs": {
    "url": "https://github.com/LevapVeeskela/lv24-Wifi-Explorer/issues"
  },
  "license": "MIT",
  "author": "LV24",
  "repository": {
    "type": "git",
    "url": "https://github.com/LevapVeeskela/lv24-Wifi-Explorer.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./domain/*": {
      "types": "./dist/domain/*.d.ts",
      "default": "./dist/domain/*.js"
    },
    "./scan": {
      "types": "./dist/scan/index.d.ts",
      "default": "./dist/scan/index.js"
    },
    "./scan/*": {
      "types": "./dist/scan/*.d.ts",
      "default": "./dist/scan/*.js"
    },
    "./import/pcap": {
      "types": "./dist/import/pcap/index.d.ts",
      "default": "./dist/import/pcap/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  }
}
