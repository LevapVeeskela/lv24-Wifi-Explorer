{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lv24.dev/wifi-explorer/scan-protocol.v1.json",
  "title": "LV24 ScanCore protocol",
  "description": "JSON Lines on stdin/stdout. Every outbound object includes protocolVersion: 1.",
  "type": "object",
  "required": ["type", "protocolVersion"],
  "properties": {
    "type": { "type": "string" },
    "protocolVersion": { "const": 1 }
  },
  "$defs": {
    "WifiBand": {
      "type": "string",
      "enum": ["2.4GHz", "5GHz", "6GHz", "unknown"]
    },
    "WifiChannelWidth": {
      "type": "string",
      "enum": ["20MHz", "40MHz", "80MHz", "80+80MHz", "160MHz", "unknown"],
      "description": "CoreWLAN has no 80+80 or 320 MHz; those values are never invented by ScanCore."
    },
    "WifiPhyMode": {
      "type": "string",
      "enum": [
        "802.11a",
        "802.11b",
        "802.11g",
        "802.11n",
        "802.11ac",
        "802.11ax",
        "802.11be",
        "unknown"
      ]
    },
    "WifiSecurityLabel": {
      "type": "string",
      "enum": [
        "Open",
        "WEP",
        "WPA Personal",
        "WPA2 Personal",
        "WPA3 Personal",
        "WPA Enterprise",
        "WPA2 Enterprise",
        "WPA3 Enterprise",
        "Mixed/Unknown"
      ]
    },
    "LocationAuthorization": {
      "type": "string",
      "enum": ["granted", "denied", "not-determined", "restricted"]
    },
    "ScanErrorCode": {
      "type": "string",
      "enum": [
        "LOCATION_DENIED",
        "LOCATION_RESTRICTED",
        "WIFI_OFF",
        "NO_INTERFACE",
        "SCAN_FAILED",
        "HELPER_UNAVAILABLE",
        "TIMEOUT",
        "BSSID_UNAVAILABLE"
      ]
    },
    "ScanError": {
      "type": "object",
      "required": ["code", "message", "recoverable"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/ScanErrorCode" },
        "message": { "type": "string" },
        "recoverable": { "type": "boolean" },
        "demoFallback": { "type": "boolean" }
      }
    },
    "ScanResult": {
      "type": "object",
      "required": [
        "id",
        "ssid",
        "bssid",
        "rssiDbm",
        "noiseDbm",
        "snrDb",
        "channel",
        "channelWidth",
        "band",
        "phyMode",
        "phyModesSupported",
        "security",
        "securityRaw",
        "oui",
        "hidden",
        "lastSeenAt",
        "scanGeneration"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "BSSID if present and Location granted; otherwise FNV-1a hash of ssid+channel+band."
        },
        "ssid": { "type": ["string", "null"] },
        "bssid": {
          "type": ["string", "null"],
          "description": "Normalized lowercase aa:bb:cc:dd:ee:ff. Null if Location denied."
        },
        "rssiDbm": { "type": ["integer", "null"] },
        "noiseDbm": {
          "type": ["integer", "null"],
          "description": "Null when noise is 0 or outside -120..-20 dBm."
        },
        "snrDb": {
          "type": ["integer", "null"],
          "description": "rssiDbm - noiseDbm when noise is valid; otherwise null."
        },
        "channel": { "type": ["integer", "null"] },
        "channelWidth": { "$ref": "#/$defs/WifiChannelWidth" },
        "band": { "$ref": "#/$defs/WifiBand" },
        "phyMode": { "$ref": "#/$defs/WifiPhyMode" },
        "phyModesSupported": {
          "type": "array",
          "items": { "$ref": "#/$defs/WifiPhyMode" }
        },
        "security": { "$ref": "#/$defs/WifiSecurityLabel" },
        "securityRaw": {
          "type": "array",
          "items": { "type": "string" },
          "description": "CWSecurity names that supportsSecurity: returned true. Not IE-deep AKM/cipher."
        },
        "oui": {
          "type": ["string", "null"],
          "description": "First three BSSID octets, uppercase hex pairs."
        },
        "hidden": { "type": "boolean" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "scanGeneration": { "type": "integer", "minimum": 1 }
      }
    },
    "ScanSnapshot": {
      "type": "object",
      "required": [
        "snapshotId",
        "capturedAt",
        "interfaceName",
        "countryCode",
        "scanDurationMs",
        "stale",
        "locationAuthorized",
        "results"
      ],
      "properties": {
        "snapshotId": { "type": "string" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "interfaceName": { "type": "string" },
        "countryCode": { "type": ["string", "null"] },
        "scanDurationMs": { "type": "integer" },
        "stale": { "type": "boolean" },
        "locationAuthorized": { "type": "boolean" },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/ScanResult" }
        },
        "error": { "$ref": "#/$defs/ScanError" },
        "location": { "$ref": "#/$defs/LocationAuthorization" },
        "source": { "type": "string" }
      }
    },
    "InboundCommand": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "scan:start",
            "scan:stop",
            "permissions:query",
            "demo:enable",
            "scan:setIntervalMs",
            "permissions:openSettings",
            "shutdown",
            "auth"
          ]
        },
        "options": {
          "type": "object",
          "properties": {
            "includeHidden": { "type": "boolean" }
          }
        },
        "enabled": { "type": "boolean" },
        "intervalMs": { "type": "integer" },
        "token": { "type": "string" }
      }
    }
  },
  "examples": [
    {
      "type": "hello",
      "protocolVersion": 1,
      "version": "1.0.0",
      "helper": "lv24-wifi-scancore",
      "transport": "stdio"
    },
    {
      "type": "locationAuthorized",
      "protocolVersion": 1,
      "payload": { "authorized": true, "location": "granted" }
    },
    {
      "type": "scan:snapshot",
      "protocolVersion": 1,
      "payload": {
        "snapshotId": "9b3c1e10-4c2a-4f0e-9a11-0f6e2c8d1a22",
        "capturedAt": "2026-09-17T19:57:00.000Z",
        "interfaceName": "en0",
        "countryCode": "US",
        "scanDurationMs": 3120,
        "stale": false,
        "locationAuthorized": true,
        "results": [
          {
            "id": "02:11:24:00:00:01",
            "ssid": "LV24-Lab-2G",
            "bssid": "02:11:24:00:00:01",
            "rssiDbm": -48,
            "noiseDbm": -92,
            "snrDb": 44,
            "channel": 6,
            "channelWidth": "20MHz",
            "band": "2.4GHz",
            "phyMode": "802.11n",
            "phyModesSupported": ["802.11b", "802.11g", "802.11n"],
            "security": "WPA2 Personal",
            "securityRaw": ["wpa2Personal"],
            "oui": "02:11:24",
            "hidden": false,
            "lastSeenAt": "2026-09-17T19:57:00.000Z",
            "scanGeneration": 1
          }
        ]
      }
    }
  ]
}
